            },
            "name": {
              "type": "string"
            },
            "names": {
              "type": "string"
            },
            "targets": {
              "type": "string"
            },
            "data": {
              "type": "string"
            },
            "overwrite": {
              "type": "boolean"
            }
          },
          "required": [
            "action"
          ]
        }
      },
      {
        "name": "blender_py",
        "description": "[v3.1] 在 ready 的 GUI 会话里执行 Python（持久内核 K），可选抓帧；只走 GUI，无 headless 回退。",
        "risk": "high",
        "schema": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "see": {
